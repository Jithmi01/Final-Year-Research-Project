# ============================================================================
# INTEGRATED APPLICATION - ENVIRONMENT VARIABLES
# Smart Wallet + Blind Assistant + Voice Recognition
# ============================================================================

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
# Flask secret key (use a random string in production)
SECRET_KEY=f5d3b2a0c7e9d8f1234567890abcdef1234567890abcdef1234567890abcdef

# Server port (default: 5000)
FLASK_PORT=5000

# Debug mode (True for development, False for production)
FLASK_DEBUG=True

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database type: 'firebase' or 'sqlite'
DATABASE_TYPE=firebase

# Firebase Database URL (if using Firebase)
FIREBASE_DATABASE_URL=https://visual-impaired-project-default-rtdb.firebaseio.com/

# ============================================================================
# MONGODB CONFIGURATION (Face + Voice Recognition)
# ============================================================================
# MongoDB connection URI (shared for face and voice recognition)
MONGODB_URI=mongodb+srv://jithmi4:Jithu2001@cluster0.qas3cqk.mongodb.net/voicevision?retryWrites=true&w=majority&appName=Cluster0

# MongoDB Database name (shared database)
MONGODB_DB_NAME=blind_assistant

# Voice Recognition Collection name (separate collection in same database)
VOICE_COLLECTION_NAME=voice_users

# ============================================================================
# VOICE RECOGNITION SETTINGS
# ============================================================================
# Similarity threshold for speaker identification (0.0 - 1.0)
# Higher = stricter matching, Lower = more lenient
# Recommended: 0.60 - 0.70
SIMILARITY_THRESHOLD=0.65

# ============================================================================
# AUDIO VALIDATION SETTINGS
# ============================================================================
# Minimum audio duration in seconds
MIN_AUDIO_DURATION=2

# Maximum audio duration in seconds
MAX_AUDIO_DURATION=30

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# SpeechBrain model name (don't change unless you know what you're doing)
MODEL_NAME=speechbrain/spkrec-ecapa-voxceleb

# Directory to save the pretrained voice model
MODEL_SAVE_DIR=pretrained_models

# ============================================================================
# NOTES
# ============================================================================
# - Keep this file private! Never commit to Git
# - Add .env to .gitignore
# - MongoDB Atlas free tier is sufficient for testing
# - Both face and voice recognition use the SAME MongoDB database (blind_assistant)
#   but different collections ('users' for faces, 'voice_users' for voices)
# - SIMILARITY_THRESHOLD affects accuracy:
#   * 0.50-0.60: More false positives, fewer false negatives
#   * 0.65-0.70: Balanced (recommended)
#   * 0.75-0.85: Fewer false positives, more false negatives
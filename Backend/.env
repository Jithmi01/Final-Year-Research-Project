# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
# Flask secret key (IMPORTANT: Change this in production!)
SECRET_KEY=f5d3b2a0c7e9d8f1234567890abcdef1234567890abcdef1234567890abcdef

# Server configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# ============================================================================
# MONGODB CONFIGURATION (Shared for Face + Voice Recognition)
# ============================================================================
# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://jithmi4:Jithu2001@cluster0.qas3cqk.mongodb.net/voicevision?retryWrites=true&w=majority&appName=Cluster0

# Database name (all features use same database but different collections)
MONGODB_DB_NAME=blind_assistant

# Optional: Override database name for voice recognition only
# Leave commented to use same database as face recognition
# DATABASE_NAME=voice_recognition_db

# ============================================================================
# VOICE RECOGNITION SETTINGS
# ============================================================================
# Similarity threshold for speaker identification (0.0 - 1.0)
# Recommended: 0.60 - 0.70 (Higher = stricter, Lower = more lenient)
SIMILARITY_THRESHOLD=0.65

# Audio validation
MIN_AUDIO_DURATION=2      # Minimum audio length in seconds
MAX_AUDIO_DURATION=30     # Maximum audio length in seconds

# ============================================================================
# MODEL CONFIGURATION (Voice Recognition)
# ============================================================================
# SpeechBrain model (don't change unless needed)
MODEL_NAME=speechbrain/spkrec-ecapa-voxceleb

# Directory to save pretrained voice model
MODEL_SAVE_DIR=pretrained_models

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=INFO

